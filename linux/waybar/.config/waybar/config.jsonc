{
  "layer": "top",
  "position": "left",
  "width": 32,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "gtk-layer-shell": true,

  "modules-left": ["group/workspaces", "hyprland/window"],
  "modules-center": ["clock"],

  "modules-right": [
    "network",
    "pulseaudio",
    "pulseaudio#mic",
    "battery",
    "custom/power",
  ],

  // Not hyprland/workspaces: it clicks with the legacy `dispatch workspace N`,
  // which Hyprland rejects under a Lua config. See docs/hyprland-desktop.md.
  "group/workspaces": {
    "orientation": "inherit",
    "modules": ["custom/ws#1", "custom/ws#2", "custom/ws#3", "custom/ws#4", "custom/ws#5"],
  },

  "custom/ws#1": {
    "exec": "~/.config/waybar/scripts/workspace.py 1",
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
  },

  "custom/ws#2": {
    "exec": "~/.config/waybar/scripts/workspace.py 2",
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
  },

  "custom/ws#3": {
    "exec": "~/.config/waybar/scripts/workspace.py 3",
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
  },

  "custom/ws#4": {
    "exec": "~/.config/waybar/scripts/workspace.py 4",
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
  },

  "custom/ws#5": {
    "exec": "~/.config/waybar/scripts/workspace.py 5",
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "rewrite": {
      "^(.{45})(.*)$": "$1…",
    },
    "rotate": 90,
  },

  "clock": {
    "format": "{:%I\n%M}",
    "interval": 60,
    "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt><small>{calendar}</small></tt>",
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰌷",
    "tooltip-format": "{ipaddr}/{cidr}\n{essid}",
    "on-click": "hyprctl dispatch \"hl.dsp.exec_cmd('[float] ghostty -e ~/.config/waybar/scripts/nmtui-mono.sh')\"",
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "hyprctl dispatch \"hl.dsp.exec_cmd('[float] ghostty -e wiremix')\"",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },

  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󱘖",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}%",
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": "Logout",
    "on-click": "wlogout -c 5 -r 5 -p layer-shell",
  },
}
