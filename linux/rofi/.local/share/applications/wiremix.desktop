[Desktop Entry]
Name=Sound
GenericName=Audio Mixer
Comment=Configure audio device settings
Exec=hyprctl dispatch "hl.dsp.exec_cmd('[float; size 60%% 60%%; center] ghostty -e wiremix')"
Terminal=false
Type=Application
Keywords=pipewire;sound;audio;volume;mixer
Categories=AudioVideo;Audio;Settings;
StartupNotify=false
