[Desktop Entry]
Name=Network
GenericName=Network Manager
Comment=Configure network connections
Exec=hyprctl dispatch "hl.dsp.exec_cmd('[float; size 60%% 60%%; center] ghostty -e \\$HOME/.config/waybar/scripts/nmtui-mono.sh')"
Terminal=false
Type=Application
Keywords=network;wifi;ethernet;connection;nmtui
Categories=Network;Settings;
StartupNotify=false
